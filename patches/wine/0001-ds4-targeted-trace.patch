+static void trace_ds4_rawinput( const RAWINPUT *input, const char *stage )
+{
+    const RAWHID *hid = &input->data.hid;
+    struct device *device;
+    UINT i;
+
+    if (!TRACE_ON(ds4) || input->header.dwType != RIM_TYPEHID ||
+        input->header.dwSize < offsetof(RAWINPUT, data.hid.bRawData) || !hid->dwSizeHid ||
+        hid->dwCount > (input->header.dwSize - offsetof(RAWINPUT, data.hid.bRawData)) / hid->dwSizeHid)
+        return;
+    pthread_mutex_lock( &rawinput_mutex );
+    device = find_device_from_handle( input->header.hDevice, FALSE );
+    if (device && device->info.dwType == RIM_TYPEHID &&
+        device->info.hid.dwVendorId == 0x054c && device->info.hid.dwProductId == 0x09cc &&
+        is_ds4_trace_descriptor( device->data ))
+        for (i = 0; i < hid->dwCount; ++i)
+        {
+            const BYTE *report = hid->bRawData + i * hid->dwSizeHid;
+            TRACE_(ds4)( "%s device=%p fingerprint=b3ad25ad id=%#x len=%u sample=%s\n",
+                         stage, input->header.hDevice, report[0], hid->dwSizeHid,
+                         debugstr_an( (const char *)report, min( hid->dwSizeHid, 12 ) ) );
+        }
+    pthread_mutex_unlock( &rawinput_mutex );
+}
