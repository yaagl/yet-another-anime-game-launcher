diff --git a/include/wine/hid.h b/include/wine/hid.h
index cb31bd6..64cd9d1 100644
--- a/include/wine/hid.h
+++ b/include/wine/hid.h
@@ -117,6 +117,23 @@ struct hid_preparsed_data
 #define HID_FEATURE_VALUE_CAPS(d) ((d)->value_caps + (d)->feature_caps_start)
 #define HID_COLLECTION_NODES(d) (struct hid_collection_node *)((char *)(d)->value_caps + (d)->caps_size)
 
+/* shortcut: local DS4 descriptor only; regenerate the fingerprint after descriptor changes. */
+static inline BOOL is_ds4_trace_descriptor( const struct hid_preparsed_data *data )
+{
+    const BYTE *bytes = (const BYTE *)data;
+    UINT i, size;
+    UINT32 hash = 2166136261u;
+
+    if (!data || memcmp( data->magic, "HidP KDR", 8 ) ||
+        data->usage_page != 1 || data->usage != 5 || data->input_report_byte_length != 547)
+        return FALSE;
+    size = FIELD_OFFSET(struct hid_preparsed_data, value_caps) + data->caps_size +
+           data->number_link_collection_nodes * sizeof(struct hid_collection_node);
+    if (size != 6404) return FALSE;
+    for (i = 0; i < size; ++i) hash = (hash ^ bytes[i]) * 16777619u;
+    return hash == 0xb3ad25ad;
+}
